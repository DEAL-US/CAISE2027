{
  "name": "caise2027-website",
  "private": true,
  "type": "module",
  "description": "The Caise 2027 Conference website",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24.11.0 <25.0.0",
    "pnpm": "12.6.0",
    "npm": "npm is not supported. Please use pnpm",
    "yarn": "yarn is not supported. Please use pnpm"
  },
  "scripts": {
    "lint": "corepack pnpm -r --if-present --no-bail lint",
    "lint:fix": "corepack pnpm -r --if-present --no-bail lint:fix",
    "check": "corepack pnpm -r --if-present --no-bail check"
  },
  "devDependencies": {
    "@eslint/config-inspector": "3.5.0",
    "@iconify/json": "2.2.533",
    "@types/node": "26.6.2",
    "eslint": "10.11.0",
    "jiti": "2.7.0",
    "type-fest": "5.10.0",
    "typescript": "6.0.3"
  }
}
