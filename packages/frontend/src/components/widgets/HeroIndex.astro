---
import { Image } from 'astro:assets';
import scenePlaceholder from '#/assets/images/hero/3d-placeholder.webp';
import Button from '#/components/ui/Button/Button.astro';
import type { Hero as Props } from '#/types';

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  subheading = await Astro.slots.render('subheading'),
  tagline,
  content = await Astro.slots.render('content'),
  actions = await Astro.slots.render('actions'),
  image,
  id
} = Astro.props;
---

<section
  class="not-prose dark bg-dark relative z-1 lg:-mt-20"
  {...id ? { id } : {}}
>
  <div class="group/scene h-full w-full absolute z-0 overflow-hidden">
    <div
      id="scene-overlay"
      class="bg-[linear-gradient(var(--colors-brand)_30%,var(--colors-brand-blue)_70%)] opacity-50 hidden inset-0 absolute mix-blend-color"
    >
    </div>
    <canvas id="scene" class="h-full w-full block"></canvas>
    {/* `hero-index-scene` adds `scene-ready` to the container once the scene has rendered */}
    <div
      class:list={[
        'pointer-events-none absolute -inset-7.5 z-1 blur-[15px]',
        'transition-[opacity,filter] duration-700 ease-[ease] motion-reduce:transition-none',
        'group-[.scene-ready]/scene:opacity-0 group-[.scene-ready]/scene:blur-0'
      ]}
      aria-hidden="true"
    >
      <Image
        src={scenePlaceholder}
        alt=""
        loading="eager"
        fetchpriority="high"
        class="h-full w-full object-cover"
      />
    </div>
  </div>
  <div class="mx-auto px-12 h-screen relative z-1 sm:px-6">
    <div class="pt-0 pointer-events-none md:pt-[76px]"></div>
    <div class="py-12 md:py-20">
      <div class:list={['mx-auto pb-10 text-center md:pb-16', { 'lg:flex': content }]}>
        {
          content && (
            <div>
              <Fragment set:html={content} />
            </div>
          )
        }
        {
          /**
           * Only a `subtitle` gets the radial plate behind it. A `subheading`
           * deliberately does not: on the dark hero the gradient resolves to
           * `--colors-dark`, which reads as a navy halo around the title.
           */
        }
        <div class={subtitle && 'text-bg-shadow'}>
          {
            tagline && (
              <p
                class="text-base text-secondary tracking-wide font-bold uppercase dark:text-blue-900"
                set:html={tagline}
              />
            )
          }
          {
            title && (
              <h1
                class="text-5xl text-brand leading-tight tracking-tighter font-bold font-heading mb-4 md:text-6xl"
                set:html={title}
              />
            )
          }
          {
            subheading && (
              <h3
                class="text-xl font-bold mb-6 dark:text-slate-900"
                set:html={subheading}
              />
            )
          }
          <div class="mx-auto max-w-7xl">
            {
              subtitle && (
                <p
                  class="text-xl mb-6 dark:text-slate-300"
                  set:html={subtitle}
                />
              )
            }
            {
              actions && (
                <div class="m-auto flex flex-col flex-nowrap gap-4 sm:flex-row sm:justify-center">
                  {Array.isArray(actions)
                    ? (
                        actions.map(action => (
                          <div class="flex w-full sm:w-auto">
                            <Button
                              {...(action || {})}
                              variant="hero"
                              class="w-full sm:mb-0"
                            />
                          </div>
                        ))
                      )
                    : (
                        <Fragment set:html={actions} />
                      )}
                </div>
              )
            }
          </div>
          <div
            onclick="window.scrollTo({ top: window.innerHeight, behavior: 'smooth' })"
            class:list={[
              'justify-self-center mt-16 flex size-[3cm] cursor-pointer items-center justify-center rounded-[100%] text-[40pt]',
              'border-2 border-[#547498] bg-brand-blue/20 text-brand-blue backdrop-blur-[5px]'
            ]}
          >
            <!-- svg of arrow (only 2 strokes) pointing down -->
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="1.5"
              stroke="currentColor"
              class="m-auto h-12 w-12"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M19 9l-7 7-7-7">
              </path>
            </svg>
          </div>
        </div>
      </div>

      <div>
        {
          image && (
            <div class="m-auto relative">
              {/* @ts-expect-error - Track https://github.com/withastro/astro/issues/10780 */}
              <Image
                class="mx-auto rounded-md w-full"
                sizes="(max-width: 767px) 400px, (max-width: 1023px) 768px, (max-width: 2039px) 1024px, 2040px"
                loading="eager"
                height={576}
                {...image}
              />
            </div>
          )
        }
      </div>
    </div>
  </div>
</section>

<script src="./hero-index-scene.ts"></script>
