---
import Layout from "#/layouts/Layout.astro";
import Header from "#/components/widgets/Header.astro";
import Footer from "#/components/widgets/Footer.astro";
import HeroIndex from "#/components/widgets/HeroIndex.astro";
import Hero from "#/components/widgets/Hero.astro";
import Announcement from "#/components/widgets/Announcement.astro";
import {
  getHeaderData,
  getFooterData,
  isInRegistrationPage,
} from "#/data/navigation";
import type { MetaData, Hero as HeroProps } from "#/types";
import type { ImageMetadata } from "astro";
import SevilleHeroImage from "@caise2027-website/assets/hero";

// If isIndex, use HeroIndex instead of Hero
export interface Props {
  metadata?: MetaData;
  heroProps?: HeroProps;
  heroImage?: ImageMetadata;
  isIndex?: boolean;
}

const { metadata, heroProps = {}, heroImage } = Astro.props;
---

<Layout metadata={metadata}>
  <slot name="announcement">
    {!isInRegistrationPage(Astro.url) && <Announcement />}
  </slot>
  <slot name="header">
    <Header {...getHeaderData(Astro.url)} isSticky showToggleTheme />
  </slot>
  <slot name="hero">
    {
      Astro.props.isIndex ? (
        <HeroIndex
          id="hero"
          title={metadata?.title}
          bg={heroImage ?? SevilleHeroImage}
          {...heroProps}
        >
          <slot name="hero-title" slot="title" />
          <slot name="hero-subtitle" slot="subtitle" />
          <slot name="hero-subheading" slot="subheading" />
          <slot name="hero-content" slot="content" />
        </HeroIndex>
      ) : null
    }
    {
      !Astro.props.isIndex && (
        <Hero
          id="hero"
          title={metadata?.title}
          bg={heroImage ?? SevilleHeroImage}
          {...heroProps}
        >
          <slot name="hero-title" slot="title" />
          <slot name="hero-subtitle" slot="subtitle" />
          <slot name="hero-subheading" slot="subheading" />
          <slot name="hero-content" slot="content" />
        </Hero>
      )
    }
  </slot>
</Layout>
<main>
  <slot />
</main>
<slot name="footer">
  <Footer {...getFooterData()} />
</slot>
