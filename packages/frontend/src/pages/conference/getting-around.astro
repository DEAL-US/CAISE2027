---
import PageLayout from '#/layouts/PageLayout.astro';
import Content from '#/components/widgets/Content.astro';

import HeaderTussam from '#/assets/images/hero/header-tussam.png';
import Sevici from '#/assets/images/commute/sevici.png';
import TussamLogo from '#/assets/images/commute/tussam.png';
import MetroLogo from '#/assets/images/commute/metro-logo.png';
import Teletaxi from '#/assets/images/arriving/teletaxi.png';
import BoltLogo from '#/assets/images/commute/bolt-logo.png';
import CabifyLogo from '#/assets/images/commute/cabify-logo.png';
import UberLogo from '#/assets/images/commute/uber-logo.svg';
import SeviciLogo from '#/assets/images/commute/sevici-logo.png';
import ElecmoveLogo from '#/assets/images/commute/elecmove-logo.png';
import AccionaLogo from '#/assets/images/commute/acciona-logo.png';
import YegoLogo from '#/assets/images/commute/yego-logo.webp';
import CooltraLogo from '#/assets/images/commute/cooltra-logo.png';

/**
 * Directions maps. `output=embed` needs no Maps API key, unlike the opaque
 * `maps/embed?pb=...` URLs, which can only be produced by Google's own UI.
 */
const venue = 'Meliá Lebreros, Calle Luis de Morales 2, Sevilla';
const directionsTo = (from: string, mode: 'w' | 'r' = 'w') =>
  `https://www.google.com/maps?saddr=${encodeURIComponent(from)}&daddr=${encodeURIComponent(venue)}&dirflg=${mode}&output=embed`;
---

<PageLayout
  metadata={{
    title: 'Getting around',
    description: 'Some of the means of transportation available in Seville'
  }}
  heroImage={HeaderTussam}>

  <Content
    classes={{
      images: '!shadow-none'
    }}
    images={[
      {
        src: Sevici,
        alt: 'Sevici bike (public bike service) in Seville',
        loading: 'eager'
      }
    ]}>
    <p slot="content">
      The pedestrian city center and the narrow streets make walking around the best option for transport in Seville.
      Nevertheless, many options exist in case you need to travel longer distances.
    </p>
  </Content>

  <Content
    title="TUSSAM"
    id="tussam"
    isReversed
    bg
    images={[
      {
        src: TussamLogo,
        alt: 'TUSSAM logo, the public bus and tram service in Seville'
      }
    ]}
    items={[
      {
        title: 'About',
        description: `Tussam is the company that controls both bus and tram transport in Seville.
        Both services have the same fares and Tussam Cards can be used for any of them.
        Most of their services run from about 6am to 11.30pm, with night buses leaving from the Prado from 12 midnight to 2am.
        For a single ride, the fare is of 1.40 euros. In case you need to make intensive use of buses or trams,
        there is also a Tarjeta Turistica (Tourist Card) valid for 1 and 3 days.
        <br />
        <br />
        You can purchase it at Tussam information stands and you can use it for all buses
        (except the special ones such as the airport bus service). It costs 5 euros for a 1-day card and 10 euros for a 3-day card.
        You’ll need to pay 1.5 euros extra that will be refunded if you return the card to a Tussam information stand.`,
        callsToAction: [{
          text: 'More about TUSSAM in their official website',
          href: 'https://www.tussam.es/en',
          variant: 'primary',
          icon: 'i-material-symbols:info-outline'
        }]
      },
      {
        title: 'Bus',
        description: `Metropolitan buses are the public transport per excellence in Seville.
        The extensive network can get you to any part of the city. The venue sits on <b>Avenida Luis de Morales</b>,
        which is served by a number of lines: the <b>C1</b> and <b>C2</b> circulars, which ring the city and connect
        with Santa Justa and San Bernardo, plus lines <b>21</b>, <b>28</b>, <b>29</b> and <b>32</b>.
        The nearest stop is <b>Luis de Morales</b>, next to the Ramón Sánchez-Pizjuán stadium.`,
        extraHtml: `<iframe
          title="Walking directions from the Luis de Morales bus stop to the Meliá Lebreros (CAiSE 2027 venue)"
          class="border-0 h-96 w-full mt-3"
          src="${directionsTo('Luis de Morales, Sevilla')}"
          allowfullscreen
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"></iframe>
        `
      },
      {
        title: 'Tramway',
        description: `Trams are the only vehicles allowed into the pedestrian area of the city,
        which makes the tram the most convenient way of travelling between the venue and the historical center.
        The single line, <b>T1</b>, now terminates at <b>Luis de Morales</b>, right by the venue, and runs to
        <b>Plaza Nueva</b> in the heart of the old town in eight stops, calling at <b>Eduardo Dato</b>,
        <b>San Francisco Javier</b>, <b>San Bernardo</b>, <b>Prado de San Sebastián</b>, <b>Puerta de Jerez</b>
        and <b>Archivo de Indias</b> along the way.`,
        extraHtml: `<iframe
          title="The Luis de Morales tram stop, next to the CAiSE 2027 venue"
          class="border-0 h-96 w-full mt-3"
          src="https://www.google.com/maps?q=${encodeURIComponent('Tranvía Luis de Morales, Sevilla')}&z=17&output=embed"
          allowfullscreen
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"></iframe>
        `
      }
    ]}>
  </Content>

  <Content
    title="Metro"
    id="metro"
    classes={{
      images: '!shadow-none'
    }}
    images={[
      {
        src: MetroLogo,
        alt: 'Metro de Sevilla logo'
      }
    ]}
    callsToAction={[
      {
        text: 'Metro Sevilla webpage',
        href: 'https://www.metro-sevilla.es/',
        icon: 'i-tabler:chevron-right',
        variant: 'primary'
      }
    ]}>
    <Fragment slot="content">
      <p>
        Line 1 crosses the city from east to west and is useful if you are staying outside Nervión.
        The nearest stops to the venue are <b>Nervión</b> and <b>Gran Plaza</b>.
      </p>
      <br />
      <iframe
        title="Walking directions from Nervión metro station to the Meliá Lebreros (CAiSE 2027 venue)"
        class="mb-3 mt-3 border-0 h-96 w-full"
        src={directionsTo('Nervión, Metro de Sevilla')}
        allowfullscreen
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade">
      </iframe>
      <br />
    </Fragment>
  </Content>

  <Content
    title="Taxi"
    id="taxi"
    isReversed
    bg
    images={[
      {
        src: Teletaxi,
        alt: 'Teletaxi logo, the business that helps arrange taxis in Seville'
      }
    ]}
    callsToAction={[
      {
        text: 'Learn more about Taxis',
        href: 'https://teletaxisevilla.es/',
        icon: 'i-tabler:chevron-right',
        variant: 'primary'
      }
    ]}>
    <Fragment slot="content">
      <p>
        In case you prefer an individual transport, taxi services are available 24 hours the day.
        Some apps, like <b>MyTaxi</b> may help you see if there is any available around you.
      </p>
      <br />
      <p>
        The fares are regulated and vary depending on the length of your travel,
        the weekday and the time when you require their services (more expensive at late night).
      </p>
      <br />
    </Fragment>
  </Content>

  <Content
    title="Uber, Cabify & Bolt"
    id="vtc"
    classes={{
      images: '!shadow-none'
    }}
    images={[
      {
        src: UberLogo,
        alt: 'Uber logo',
        class: 'dark:invert'
      },
      {
        src: CabifyLogo,
        alt: 'Cabify logo'
      },
      {
        src: BoltLogo,
        alt: 'Bolt logo'
      }
    ]}
    callsToAction={[
      {
        text: 'Learn more about Uber',
        href: 'https://www.uber.com/global/en/price-estimate/',
        icon: 'i-tabler:chevron-right',
        variant: 'primary'
      },
      {
        text: 'Learn more about Cabify',
        href: 'https://cabify.com/en',
        icon: 'i-tabler:chevron-right',
        variant: 'primary'
      },
      {
        text: 'Learn more about Bolt',
        href: 'https://bolt.eu/en-es/',
        icon: 'i-tabler:chevron-right',
        variant: 'primary'
      }
    ]}>
    <Fragment slot="content">
      <p>
        These are the available VTC services in the city. Their services can be reserved through their apps, just like in many other cities.
      </p>
      <br />
      <p>
        The estimated fare for an UberX is aproximately of 1.20 per kilometre and 0.10 per minute of travel,
        which may lead to cheaper services when compared to the taxi.
      </p>
    </Fragment>
  </Content>

  <Content
    title="Bicycle"
    id="bicycle"
    isReversed
    bg
    items={[
      {
        title: 'Sevici',
        description: `Would you rather choose a green alternative and go biking to the venue?
        Seville has a local bike rental with many parking stations all around the city.
        In every parking station there is an System Access Terminal where you can get a weekly subscription to the rental, check the map,
        get information in both spanish and english...
        <br />
        <br />
        Note that a 150 € deposit that is recovered later is needed in short term subscriptions.
        The weekly subscription costs 13.33 € and, with that, the first 30 minutes of biking are free.`,
        image: {
          src: SeviciLogo,
          alt: 'Sevici logo (public bike service in Seville)'
        },
        callsToAction: [
          {
            text: 'Learn more about Sevici rates',
            href: 'https://www.sevici.es/en/offers/groups/list#154415',
            icon: 'i-tabler:chevron-right',
            variant: 'primary'
          }
        ]
      },
      {
        title: 'Elecmove',
        description: `The leading company in Seville offering all services related to electric bikes.
        Discover a city riding a bike is fun and eco-friendly!`,
        image: {
          src: ElecmoveLogo,
          alt: 'Elecmove logo'
        },
        callsToAction: [
          {
            text: 'Learn more about Elecmove rates',
            href: 'https://elecmove.com/en/electric-bike-rental/',
            icon: 'i-tabler:chevron-right',
            variant: 'primary'
          }
        ]
      }
    ]}>
  </Content>

  <Content
    title="Motorbike"
    id="motorbike"
    items={[
      {
        title: 'Acciona',
        description: `The standard fare is 0.25 euros per minute,
        but there are passes available in case you know you are going to use it more often.
        The first 20 minutes are free of charge.`,
        image: {
          src: AccionaLogo,
          alt: 'Acciona logo'
        },
        callsToAction: [
          {
            text: 'Learn more about Acciona',
            href: 'https://movilidad.acciona.com/en_ES/seville/',
            icon: 'i-tabler:chevron-right',
            variant: 'primary'
          }
        ]
      },
      {
        title: 'Yego',
        description: `The standard fare is 0.31 euros per minute,
        but there are passes available in case you know you are going to use it more often.`,
        image: {
          src: YegoLogo,
          alt: 'Yego logo',
          width: 200
        },
        callsToAction: [
          {
            text: 'Learn more about Yego',
            href: 'https://rideyego.com/en/how-it-works/sevilla',
            icon: 'i-tabler:chevron-right',
            variant: 'primary'
          }
        ]
      },
      {
        title: 'Cooltra',
        description: `The standard fare is 0.26 euros per minute,
        but there are passes available in case you know you are going to use it more often.`,
        image: {
          src: CooltraLogo,
          alt: 'Cooltra logo',
          width: 200
        },
        callsToAction: [
          {
            text: 'Learn more about Cooltra rates',
            href: 'https://cooltra.com/en/rent-by-minutes-hours/our-prices/',
            icon: 'i-tabler:chevron-right',
            variant: 'primary'
          }
        ]
      }
    ]}>
    <p slot="content">
      There are three main operating motorbike renting systems: Acciona, Yego and Cooltra.
      This kind of rental, also known as "motosharing", lets you take and leave the motorbike anywhere around the city.
      The renting is controlled through their mobile apps.
    </p>
  </Content>
</PageLayout>
