{
  "name": "@caise2027-website/backend",
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "prisma": "corepack pnpm prisma:generate && corepack pnpm prisma:migrate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:create-migration": "prisma migrate dev",
    "start": "corepack pnpm prisma && corepack pnpm listhen:dev",
    "prod": "corepack pnpm prisma && corepack pnpm listhen:prod",
    "listhen:dev": "DEV=1 listhen -w ./src/app.ts",
    "listhen:prod": "listhen --public --qr false ./src/app.ts",
    "check": "corepack pnpm check:types",
    "check:types": "corepack pnpm prisma:generate && tsc",
    "lint": "corepack pnpm prisma:generate && eslint .",
    "lint:fix": "corepack pnpm prisma:generate && eslint . --fix",
    "lint:inspect": "eslint-config-inspector"
  },
  "devDependencies": {
    "@caise2027-website/configs": "workspace:*",
    "@types/nodemailer": "8.0.1",
    "dotenv": "17.4.2"
  },
  "dependencies": {
    "@caise2027-website/shared": "workspace:*",
    "@prisma/client": "7.9.0",
    "consola": "3.4.2",
    "destr": "2.0.5",
    "h3": "1.15.11",
    "image-size": "2.0.2",
    "listhen": "1.10.1",
    "microinvoice": "2.0.2",
    "nodemailer": "9.0.3",
    "prisma": "7.9.0"
  }
}
